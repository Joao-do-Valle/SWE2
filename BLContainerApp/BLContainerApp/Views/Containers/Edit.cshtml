@model Container

@{
    ViewData["Title"] = "Editar Container";
}

<h1>Editar Container</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Numero" class="control-label"></label>
                <input asp-for="Numero" class="form-control" maxlength="11" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Tipo" class="control-label"></label>
                <select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList<TipoContainer>()"></select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Tamanho" class="control-label"></label>
                <select asp-for="Tamanho" class="form-select" asp-items="Html.GetEnumSelectList<TamanhoContainer>()"></select>
                <span asp-validation-for="Tamanho" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="BLId" class="control-label">BL</label>
                <select asp-for="BLId" class="form-select" asp-items="ViewBag.BLId"></select>
                <span asp-validation-for="BLId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-warning">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>
