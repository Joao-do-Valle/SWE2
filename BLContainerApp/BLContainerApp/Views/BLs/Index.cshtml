@model IEnumerable<BL>

@{
    ViewData["Title"] = "BLs";
}

<h1>BLs</h1>

<p>
    <a asp-action="Create" class="btn btn-success">+ Novo BL</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Numero)</th>
            <th>@Html.DisplayNameFor(model => model.Consignee)</th>
            <th>@Html.DisplayNameFor(model => model.Navio)</th>
            <th>Containers</th>
            <th style="width: 260px;"></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Numero)</td>
            <td>@Html.DisplayFor(modelItem => item.Consignee)</td>
            <td>@Html.DisplayFor(modelItem => item.Navio)</td>
            <td>@item.Containers.Count</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Nenhum BL cadastrado ainda.</p>
}
