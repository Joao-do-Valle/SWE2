@model BL

@{
    ViewData["Title"] = "Detalhes do BL";
}

<h1>Detalhes do BL</h1>

<div class="col-md-6">
    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Numero)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Numero)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Consignee)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Consignee)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Navio)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Navio)</dd>
    </dl>
</div>

<h4>Containers associados</h4>
@if (Model.Containers.Any())
{
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Número</th>
                <th>Tipo</th>
                <th>Tamanho</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Containers)
        {
            <tr>
                <td>@c.Numero</td>
                <td>@c.Tipo</td>
                <td>@((int)c.Tamanho) pés</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Nenhum container associado a este BL.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
