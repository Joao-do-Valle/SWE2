@model IEnumerable<BL>

@{
    ViewData["Title"] = "Relatório de BL / Container";
}

<h1>Relatório de BL / Container</h1>
<p class="text-muted">Listagem consolidada de todos os BLs e seus respectivos containers.</p>

@if (Model.Any())
{
    @foreach (var bl in Model)
    {
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">
                <strong>BL:</strong> @bl.Numero
                &nbsp;|&nbsp;
                <strong>Consignee:</strong> @bl.Consignee
                &nbsp;|&nbsp;
                <strong>Navio:</strong> @bl.Navio
            </div>
            <div class="card-body">
                @if (bl.Containers.Any())
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead>
                            <tr>
                                <th>Número do Container</th>
                                <th>Tipo</th>
                                <th>Tamanho</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var c in bl.Containers)
                        {
                            <tr>
                                <td>@c.Numero</td>
                                <td>@c.Tipo</td>
                                <td>@((int)c.Tamanho) pés</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">Nenhum container associado a este BL.</p>
                }
            </div>
        </div>
    }
}
else
{
    <p class="text-muted">Nenhum BL cadastrado.</p>
}
