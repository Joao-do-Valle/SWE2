@* Validação no navegador (jQuery Validation). O servidor valida de novo, então nada depende só disto. *@
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Aceita número no formato brasileiro (1.234,56) nas regras "number" e "range"
    $.validator.methods.number = function (valor, elemento) {
        return this.optional(elemento) || /^-?(?:\d+|\d{1,3}(?:\.\d{3})+)(?:,\d+)?$/.test(valor);
    };
    $.validator.methods.range = function (valor, elemento, parametros) {
        var numero = parseFloat(String(valor).replace(/\./g, '').replace(',', '.'));
        return this.optional(elemento) ||
            (numero >= parseFloat(parametros[0]) && numero <= parseFloat(parametros[1]));
    };
</script>
