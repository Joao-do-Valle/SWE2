<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Controle de Estoque</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="marca" asp-controller="Produtos" asp-action="Index">Controle de Estoque</a>
            <a class="btn btn-sm btn-light" asp-controller="Produtos" asp-action="Criar">Novo produto</a>
        </div>
    </header>

    <main class="container conteudo">
        @if (TempData["Sucesso"] is string mensagem)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensagem
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="rodape">
        <div class="container">
            TP03 de CBTSWE2 (ADS 671), IFSP Cubatão. Dupla: André Luiz Nascimento de Andrade e João do Valle Seixas Paula.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
