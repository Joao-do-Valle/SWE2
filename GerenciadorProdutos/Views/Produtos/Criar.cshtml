@model Produto
@{
    ViewData["Title"] = "Novo produto";
}

<h1 class="titulo-pagina">Novo produto</h1>

<form asp-action="Criar" class="formulario" novalidate>
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar produto</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
